{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 10,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "linux-debug",
            "binaryDir": "${sourceDir}/Linux_Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "GENERATE_DEBUG_SYMBOLS": "ON"
            }
        },
        {
            "name": "linux-release",
            "binaryDir": "${sourceDir}/Linux_Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "GENERATE_DEBUG_SYMBOLS": "OFF"
            }
        },
        {
            "name": "windows",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/Windows",
            "toolset": "ClangCL",
            "cacheVariables": {
                "GENERATE_DEBUG_SYMBOLS": "OFF"
            }
        }
    ]
}
